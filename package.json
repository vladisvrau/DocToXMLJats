{
  "name": "doctoxmljats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @doctoxmljats/web",
    "build:web": "npm run build -w @doctoxmljats/web",
    "dev:desktop": "npm run dev -w @doctoxmljats/desktop",
    "build:desktop": "npm run build -w @doctoxmljats/desktop",
    "dist:desktop": "npm run dist -w @doctoxmljats/desktop",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
